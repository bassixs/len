# Скопируйте в .env.local и заполните (файлы *.local не в git).

# Включить Vite-фронт в режиме headless: каталог и product.html?woo=ID из WooCommerce REST API
VITE_USE_WOO=true

# URL сайта с WooCommerce, без слэша в конце
WOO_ORIGIN=https://njenlen.ru

# REST API: WooCommerce → Настройки → Дополнительно → REST API (права Read)
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
